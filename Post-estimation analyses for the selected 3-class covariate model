# ---- wording check (Cohen's d)
dd <- function(x, a1, a2) { x1 <- x[g == a1]; x2 <- x[g == a2]
  sp <- sqrt(((length(x1) - 1) * var(x1) + (length(x2) - 1) * var(x2)) / (length(x1) + length(x2) - 2)); (mean(x1) - mean(x2)) / sp }
out$wording <- rbind(neg = c(M_L = dd(dat$neg, "Moderate", "Low"), H_M = dd(dat$neg, "High", "Moderate"), H_L = dd(dat$neg, "High", "Low")),
                     pos = c(M_L = dd(dat$pos, "Moderate", "Low"), H_M = dd(dat$pos, "High", "Moderate"), H_L = dd(dat$pos, "High", "Low")))
print(round(out$wording, 2))

