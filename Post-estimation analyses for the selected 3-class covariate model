# ---- retest classification with fixed baseline parameters
kappa_w <- function(x, y, w = c("none", "linear")) {
  w <- match.arg(w); x <- factor(x, 1:3); y <- factor(y, 1:3); t <- table(x, y) / length(x)
  W <- if (w == "none") 1 - diag(3) else abs(outer(1:3, 1:3, "-")) / 2
  1 - sum(W * t) / sum(W * outer(rowSums(t), colSums(t))) }
rt <- !is.na(dat$R1) & complete.cases(dat[, paste0("R", 1:10)])
# map retest raw 1-5 scores onto baseline consecutive codes; unseen categories -> missing (NA)
lev <- lapply(1:10, function(j) sort(unique(dat[[paste0("I", j)]])))
Yr <- sapply(1:10, function(j) match(dat[[paste0("R", j)]], lev[[j]]))
Xr <- cbind(1, dat$age10, dat$female, dat$alone)
post_fixed <- function(m, Yr, X, drop6 = FALSE) {
  C <- length(m$P); eta <- X %*% cbind(0, m$coeff); prior <- exp(eta) / rowSums(exp(eta))
  L <- prior
  for (j in 1:10) { if (drop6 && j == 6) next
    for (c in 1:C) { pj <- m$probs[[j]][c, Yr[, j]]; pj[is.na(pj)] <- 1; L[, c] <- L[, c] * pj } }
  L / rowSums(L) }
labmap <- c(3, 1, 2)
pr1 <- post_fixed(mr, Yr, Xr); r_cls <- labmap[apply(pr1, 1, which.max)]
pr2 <- post_fixed(mr, Yr, Xr, drop6 = TRUE); r_cls2 <- labmap[apply(pr2, 1, which.max)]
b_cls <- as.integer(dat$cls)
rtab <- function(rc) list(n = sum(rt), agree = 100 * mean(b_cls[rt] == rc[rt]), kappa = kappa_w(b_cls[rt], rc[rt]),
  wkappa = kappa_w(b_cls[rt], rc[rt], "linear"), tab = table(baseline = b_cls[rt], retest = rc[rt]))
out$retest <- rtab(r_cls); out$retest_drop6 <- rtab(r_cls2)
out$retest_unseen <- colSums(is.na(Yr[rt, ]))
print(out$retest); print(out$retest_drop6); print(out$retest_unseen)

# ---- sensitivity: unconditional 3-class vs covariate classification; collapsed 2-class vs final
match_kappa <- function(a1, b1) { # best label permutation
  perms <- list(c(1,2,3), c(1,3,2), c(2,1,3), c(2,3,1), c(3,1,2), c(3,2,1)); best <- NULL
  for (p in perms) { bb <- p[b1]; ag <- mean(a1 == bb); if (is.null(best) || ag > best$ag) best <- list(ag = ag, k = kappa_w(a1, bb)) }
  best }
out$sens_unc <- match_kappa(b_cls, M$unc[[3]]$predclass)
c2 <- M$col[[2]]$predclass
out$sens_col <- table(final = dat$cls, collapsed2 = c2)
print(out$sens_unc); print(out$sens_col)

