# Post-estimation analyses for the selected 3-class covariate model
suppressMessages(library(poLCA))
R <- readRDS("/home/claude/stats2/models.rds"); M <- R$M; dat <- R$dat
BL <- tryCatch(readRDS("/home/claude/stats2/blrt.rds"), error = function(e) NULL)
P <- readRDS("/home/claude/stats2/prep.rds")
stopifnot(identical(P$a$id, dat$id)); for (v in paste0("R", 1:10)) dat[[v]] <- P$a[[v]]
out <- list()
r2 <- function(x, d = 2) formatC(x, format = "f", digits = d)

entropy <- function(m) { p <- m$posterior; C <- ncol(p); if (C == 1) return(NA)
  1 - sum(-p * log(pmax(p, 1e-300))) / (nrow(p) * log(C)) }
# number of empty-category parameters poLCA would have counted under the manuscript's coding
# (I5 and I6 each skip one category on the 1-5 scale): each adds 1 parameter per class
fitrow <- function(m, C, empty = 0) {
  n <- m$Nobs; k <- m$npar; ll <- m$llik
  k2 <- k + empty * C
  sab <- function(k) -2 * ll + k * log((n + 2) / 24)
  data.frame(C = C, LL = ll, k = k, AIC = -2 * ll + 2 * k, BIC = -2 * ll + k * log(n), SABIC = sab(k),
             BIC_k_ms = -2 * ll + k2 * log(n), k_ms = k2,
             entropy = entropy(m), smallest_n = min(table(factor(m$predclass, levels = 1:C))),
             smallest_pct = 100 * min(table(factor(m$predclass, levels = 1:C))) / n,
             rep = if (C == 1) NA else paste0(m$rep_count, "/", m$nrep))
}
fit_cov <- do.call(rbind, lapply(1:5, function(C) fitrow(M$cov[[C]], C, 1)))
fit_unc <- do.call(rbind, lapply(1:5, function(C) fitrow(M$unc[[C]], C, 1)))
fit_col <- do.call(rbind, lapply(1:5, function(C) fitrow(M$col[[C]], C, 0)))
out$fit_cov <- fit_cov; out$fit_unc <- fit_unc; out$fit_col <- fit_col; out$BL <- BL
print(fit_cov); print(fit_unc); print(fit_col); print(BL)

# ---- final model, ordered high -> moderate -> low; refit with low-risk as reference (class 1 in poLCA)
m3 <- M$cov[[3]]
sev <- tapply(dat$mean_item, m3$predclass, mean)
ord_desc <- order(sev, decreasing = TRUE)                 # high, moderate, low
f_cov <- as.formula(paste0("cbind(", paste0("Y", 1:10, collapse = ","), ") ~ age10 + female + alone"))
ps <- poLCA.reorder(m3$probs.start, c(ord_desc[3], ord_desc[1], ord_desc[2]))   # low, high, moderate
mr <- poLCA(f_cov, dat, nclass = 3, probs.start = ps, nrep = 1, maxiter = 5000, verbose = FALSE)
stopifnot(abs(mr$llik - m3$llik) < 1e-3)
# poLCA class 1 = low, 2 = high, 3 = moderate  -> paper labels: 1 high, 2 moderate, 3 low
lab <- c(3, 1, 2)[mr$predclass]
dat$cls <- factor(lab, levels = 1:3, labels = c("High", "Moderate", "Low"))
pp <- mr$posterior[, c(2, 3, 1)]
out$avepp <- sapply(1:3, function(k) mean(pp[lab == k, k]))
out$n <- table(dat$cls); out$pct <- 100 * prop.table(out$n)
cat("\nClass sizes:\n"); print(out$n); print(round(out$pct, 1)); print(round(out$avepp, 3))
cat("Entropy:", entropy(mr), "\n")

# ---- covariate effects
b <- mr$coeff                       # rows: intercept, age10, female, alone; cols: class2(high), class3(mod) vs class1(low)
se <- mr$coeff.se
V <- mr$coeff.V                     # order = as.vector(b)
stopifnot(max(abs(sqrt(diag(V)) - as.vector(se))) < 1e-6)
covtab <- data.frame()
for (j in 2:4) {
  idx <- c(j, j + nrow(b))
  w <- as.numeric(t(b[j, ]) %*% solve(V[idx, idx]) %*% b[j, ])
  covtab <- rbind(covtab, data.frame(cov = rownames(b)[j],
    OR_high = exp(b[j, 1]), lo_high = exp(b[j, 1] - 1.96 * se[j, 1]), hi_high = exp(b[j, 1] + 1.96 * se[j, 1]),
    OR_mod = exp(b[j, 2]), lo_mod = exp(b[j, 2] - 1.96 * se[j, 2]), hi_mod = exp(b[j, 2] + 1.96 * se[j, 2]),
    wald = w, p = pchisq(w, 2, lower.tail = FALSE)))
}
out$covtab <- covtab; print(covtab, digits = 3)

