  c(sapply(levels(g), function(l) sprintf("%.2f (%.2f)", mean(x[g == l]), sd(x[g == l]))),
    H = r2(H), eta2 = r2(eta(H, length(x))), p = format.pval(kruskal.test(x ~ g)$p.value, 3),
    padj = paste(formatC(pw(x), format = "g", digits = 3), collapse = " / ")) }))
