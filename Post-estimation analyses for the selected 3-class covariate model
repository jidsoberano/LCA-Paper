eta <- function(H, n, k = 3) (H - k + 1) / (n - k)
pw <- function(x) { pr <- list(c("High", "Moderate"), c("High", "Low"), c("Moderate", "Low"))
  sapply(pr, function(p) min(1, 3 * wilcox.test(x[g == p[1]], x[g == p[2]], exact = FALSE)$p.value)) }
