# ---- Sensitivity analyses
# Compare unconditional three-class classification with the covariate
# classification, and collapsed two-class classification with the final model.

match_kappa <- function(a1, b1) {
  permutations <- list(
    c(1, 2, 3),
    c(1, 3, 2),
    c(2, 1, 3),
    c(2, 3, 1),
    c(3, 1, 2),
    c(3, 2, 1)
  )

  valid <- complete.cases(a1, b1)
  a1 <- a1[valid]
  b1 <- b1[valid]

  best <- NULL

  for (permutation in permutations) {
    bb <- permutation[b1]
    agreement <- mean(a1 == bb)

    if (is.null(best) || agreement > best$ag) {
      best <- list(
        ag = agreement,
        k = kappa_w(a1, bb),
        permutation = permutation
      )
    }
  }

  best
}

