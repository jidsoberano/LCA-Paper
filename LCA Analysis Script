# ---- Wording check using Cohen's d

dd <- function(x, a1, a2) {
  x1 <- x[g == a1 & !is.na(x)]
  x2 <- x[g == a2 & !is.na(x)]

  pooled_sd <- sqrt(
    (
      (length(x1) - 1) * var(x1) +
        (length(x2) - 1) * var(x2)
    ) /
      (length(x1) + length(x2) - 2)
  )

  (mean(x1) - mean(x2)) / pooled_sd
}

