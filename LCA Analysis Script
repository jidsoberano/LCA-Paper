post_fixed <- function(m, Yr, X, drop6 = FALSE) {
  C <- length(m$P)

  eta_value <- X %*% cbind(0, m$coeff)
  eta_value <- sweep(
    eta_value,
    1,
    apply(eta_value, 1, max),
    FUN = "-"
  )

  prior <- exp(eta_value)
  prior <- prior / rowSums(prior)

  likelihood <- prior

  for (j in 1:10) {
    if (drop6 && j == 6) {
      next
    }

    for (class_index in 1:C) {
      response_index <- Yr[, j]
      item_prob <- rep(1, nrow(Yr))
      observed <- !is.na(response_index)

      item_prob[observed] <- m$probs[[j]][
        class_index,
        response_index[observed]
      ]

      likelihood[, class_index] <-
        likelihood[, class_index] * item_prob
    }
  }

  row_totals <- rowSums(likelihood)
  valid <- is.finite(row_totals) & row_totals > 0

  posterior <- matrix(
    NA_real_,
    nrow = nrow(likelihood),
    ncol = ncol(likelihood)
  )

  posterior[valid, ] <-
    likelihood[valid, , drop = FALSE] / row_totals[valid]

  posterior
}

