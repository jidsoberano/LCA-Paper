# ---- Model-fit statistics

entropy <- function(m) {
  p <- m$posterior
  C <- ncol(p)

  if (C == 1) {
    return(NA_real_)
  }

  1 - sum(-p * log(pmax(p, 1e-300))) / (nrow(p) * log(C))
}

fitrow <- function(m, C, empty = 0) {
  n <- m$Nobs
  k <- m$npar
  ll <- m$llik
  k2 <- k + empty * C

  sab <- function(k_value) {
    -2 * ll + k_value * log((n + 2) / 24)
  }

  class_counts <- table(
    factor(m$predclass, levels = seq_len(C))
  )

  data.frame(
    C = C,
    LL = ll,
    k = k,
    AIC = -2 * ll + 2 * k,
    BIC = -2 * ll + k * log(n),
    SABIC = sab(k),
    BIC_k_ms = -2 * ll + k2 * log(n),
    k_ms = k2,
    entropy = entropy(m),
    smallest_n = min(class_counts),
    smallest_pct = 100 * min(class_counts) / n,
    rep = if (C == 1) {
      NA_character_
    } else {
      paste0(m$rep_count, "/", m$nrep)
    }
  )
}

