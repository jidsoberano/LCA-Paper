# ---- Retest classification using fixed baseline parameters

kappa_w <- function(x, y, w = c("none", "linear")) {
  w <- match.arg(w)

  complete <- complete.cases(x, y)
  x <- factor(x[complete], levels = 1:3)
  y <- factor(y[complete], levels = 1:3)

  observed <- table(x, y) / length(x)

  weights <- if (w == "none") {
    1 - diag(3)
  } else {
    abs(outer(1:3, 1:3, "-")) / 2
  }

  expected <- outer(
    rowSums(observed),
    colSums(observed)
  )

  denominator <- sum(weights * expected)

  if (denominator == 0) {
    return(NA_real_)
  }

  1 - sum(weights * observed) / denominator
}

