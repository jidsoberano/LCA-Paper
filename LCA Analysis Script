# ---- Reliability

alpha <- function(X) {
  X <- as.data.frame(X)
  X <- X[complete.cases(X), , drop = FALSE]

  k <- ncol(X)

  if (k < 2) {
    return(NA_real_)
  }

  total_variance <- var(rowSums(X))

  if (is.na(total_variance) || total_variance == 0) {
    return(NA_real_)
  }

  k / (k - 1) *
    (1 - sum(vapply(X, var, numeric(1))) / total_variance)
}

